{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Con-Benksl/NetOps/schemas/fleet.schema.json",
  "title": "NetOps Private Fleet Overlay",
  "type": "object",
  "required": ["schema_version", "fleet_name", "hosts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fleet_name": {"type": "string", "minLength": 1},
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["alias", "role", "management", "ssh", "domains"],
        "properties": {
          "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "role": {"type": "string"},
          "management": {
            "type": "object",
            "required": ["address"],
            "properties": {
              "address": {"type": "string", "minLength": 1},
              "panel_reference": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "ssh": {
            "type": "object",
            "properties": {
              "user": {"type": ["string", "null"]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "config_host": {"type": ["string", "null"]},
              "identity_file": {"type": ["string", "null"]},
              "credential_reference": {"type": ["string", "null"]},
              "password_env": {
                "type": ["string", "null"],
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "additionalProperties": false
          },
          "domains": {
            "type": "object",
            "properties": {
              "ipv4": {"type": "array", "items": {"type": "string"}},
              "ipv6": {"type": "array", "items": {"type": "string"}},
              "panel": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "expected_services": {
            "type": "array",
            "items": {"type": "string"}
          },
          "labels": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": false,
        "not": {
          "anyOf": [
            {"required": ["password"]},
            {"required": ["token"]},
            {"required": ["private_key"]},
            {"required": ["secret"]},
            {"required": ["uuid"]}
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
