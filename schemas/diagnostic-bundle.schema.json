{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Con-Benksl/NetOps/schemas/diagnostic-bundle.schema.json",
  "title": "NetOps Diagnostic Bundle",
  "$defs": {
    "boundedJsonValue": {
      "anyOf": [
        {"type": ["null", "boolean", "number"]},
        {"type": "string", "maxLength": 1048576},
        {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/boundedJsonValue"}
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {"$ref": "#/$defs/boundedJsonValue"}
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "vantage_points",
    "environment",
    "observations",
    "path_segments",
    "findings",
    "limitations",
    "redactions",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "mode": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "vantage_points": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 1048576}
    },
    "environment": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {"$ref": "#/$defs/boundedJsonValue"}
    },
    "targets": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "maxProperties": 10000,
        "additionalProperties": {"$ref": "#/$defs/boundedJsonValue"}
      }
    },
    "path_segments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence",
          "limitations",
          "vantage_points",
          "observed_at",
          "confidence"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 1048576},
          "status": {
            "type": "string",
            "enum": ["observed", "partially-observed", "failed", "unknown", "ok"]
          },
          "evidence": {
            "type": "array",
            "maxItems": 10000,
            "items": {"type": "string", "format": "uuid"}
          },
          "limitations": {
            "type": "array",
            "maxItems": 10000,
            "items": {"type": "string", "maxLength": 1048576}
          },
          "vantage_points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {"type": "string", "minLength": 1, "maxLength": 1048576}
          },
          "observed_at": {"type": "string", "format": "date-time"},
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["severity", "segment", "title", "evidence", "confidence"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error", "critical"]
          },
          "segment": {"type": "string", "minLength": 1, "maxLength": 1048576},
          "title": {"type": "string", "minLength": 1, "maxLength": 1048576},
          "evidence": {
            "type": "array",
            "maxItems": 10000,
            "items": {"type": "string", "format": "uuid"}
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 1048576}
    },
    "redactions": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 1048576}
    },
    "observations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observed_at",
          "vantage_point",
          "segment",
          "probe",
          "status",
          "metrics",
          "evidence",
          "confidence",
          "limitations"
        ],
        "properties": {
          "observation_id": {"type": "string", "format": "uuid"},
          "observed_at": {"type": "string", "format": "date-time"},
          "vantage_point": {"type": "string", "maxLength": 1048576},
          "segment": {"type": "string", "maxLength": 1048576},
          "probe": {"type": "string", "maxLength": 1048576},
          "status": {"enum": ["ok", "failed", "unknown"]},
          "target": {"type": ["string", "null"], "maxLength": 1048576},
          "protocol": {"type": ["string", "null"], "maxLength": 1048576},
          "address_family": {"type": ["string", "null"], "maxLength": 1048576},
          "metrics": {
            "type": "object",
            "maxProperties": 10000,
            "additionalProperties": {"$ref": "#/$defs/boundedJsonValue"}
          },
          "evidence": {
            "type": "object",
            "maxProperties": 10000,
            "additionalProperties": {"$ref": "#/$defs/boundedJsonValue"}
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "limitations": {
            "type": "array",
            "maxItems": 10000,
            "items": {"type": "string", "maxLength": 1048576}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
