{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Con-Benksl/NetOps/schemas/diagnostic-bundle.schema.json",
  "title": "NetOps Diagnostic Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "vantage_points",
    "environment",
    "observations",
    "path_segments",
    "findings",
    "limitations",
    "redactions",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "mode": {"type": "string", "minLength": 1},
    "started_at": {"type": "string"},
    "completed_at": {"type": ["string", "null"]},
    "vantage_points": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object"},
    "targets": {"type": "array", "items": {"type": "object"}},
    "path_segments": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "redactions": {"type": "array", "items": {"type": "string"}},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observed_at",
          "vantage_point",
          "segment",
          "probe",
          "status",
          "metrics",
          "evidence",
          "confidence",
          "limitations"
        ],
        "properties": {
          "observation_id": {"type": "string", "format": "uuid"},
          "observed_at": {"type": "string"},
          "vantage_point": {"type": "string"},
          "segment": {"type": "string"},
          "probe": {"type": "string"},
          "status": {"enum": ["ok", "failed", "unknown"]},
          "target": {"type": ["string", "null"]},
          "protocol": {"type": ["string", "null"]},
          "address_family": {"type": ["string", "null"]},
          "metrics": {"type": "object"},
          "evidence": {"type": "object"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
