{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Con-Benksl/NetOps/schemas/change-plan.schema.json",
  "title": "NetOps Reviewed Change Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "source_spec",
    "name",
    "summary",
    "host_alias",
    "host",
    "invariants",
    "backup_paths",
    "backup_root",
    "payloads",
    "operations",
    "restart_services"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "created_at": {"type": "string"},
    "source_spec": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "host_alias": {"type": "string", "minLength": 1},
    "host": {
      "type": "object",
      "required": ["alias", "management", "ssh"],
      "properties": {
        "alias": {"type": "string"},
        "management": {"type": "object"},
        "ssh": {"type": "object"}
      },
      "additionalProperties": false
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "backup_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "backup_root": {"type": "string"},
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["local_path", "remote_path", "mode", "size", "sha256"],
        "properties": {
          "local_path": {"type": "string"},
          "remote_path": {"type": "string"},
          "mode": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "description", "command", "timeout_seconds"],
        "properties": {
          "phase": {
            "enum": [
              "preflight",
              "apply",
              "validate",
              "verify",
              "rollback",
              "rollback_verify"
            ]
          },
          "description": {"type": "string"},
          "command": {"type": "string"},
          "timeout_seconds": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "restart_services": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
